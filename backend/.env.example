APP_NAME=SaruSystems OS
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://sarusystems:sarusystems@localhost:5432/sarusystems_os
SECRET_KEY=replace-with-a-strong-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional OpenAI-compatible Founder AI Assistant provider
# Configure these only in the deployment secret manager; never commit real credentials.
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_PROVIDER_TIMEOUT_SECONDS=30
